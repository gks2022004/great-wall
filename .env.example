# Password that unlocks editing. Everyone else gets a read-only view of your wall.
ADMIN_PASSWORD=change-me

# Random string used to sign the login cookie (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Telegram storage. Leave empty to store files on local disk instead (./data/uploads).
# 1. Create a bot with @BotFather and paste its token here.
# 2. Create a private channel, add the bot as an admin (post, edit, delete and pin messages).
# 3. Put the channel id here (looks like -1001234567890, or @channelusername for public channels).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=3000
# Where the wall state, local uploads and the download cache live.
DATA_DIR=./data
# Largest single upload accepted, in MB. Files above 19 MB are split into chunks on Telegram.
MAX_UPLOAD_MB=200
# Size of the on-disk cache for files pulled back from Telegram, in MB.
CACHE_MAX_MB=1024
# Optional: point at a self-hosted Bot API server (https://github.com/tdlib/telegram-bot-api).
TELEGRAM_API_URL=
